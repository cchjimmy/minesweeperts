{
  "tasks": {
    "build": "deno bundle ./src/main.ts -o ./build/out.js",
    "serve": "deno serve -R ./src/server.ts",
    "start": "deno task build; deno task serve"
  },
  "compilerOptions": {
    "lib": ["dom", "esnext", "deno.ns"]
  },
  "imports": {
    "@std/http": "jsr:@std/http@^1.1.1"
  }
}
